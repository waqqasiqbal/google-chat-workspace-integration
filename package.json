{
  "name": "google-chat-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google Chat",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "login": "node dist/auth/login.js",
    "start": "node dist/index.js",
    "login:readonly": "TOKEN_STORE_PATH=.credentials/readonly/token.json GOOGLE_CHAT_SCOPES=https://www.googleapis.com/auth/chat.spaces.readonly,https://www.googleapis.com/auth/chat.memberships.readonly,https://www.googleapis.com/auth/chat.messages.readonly,https://www.googleapis.com/auth/chat.users.readstate.readonly,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/gmail.readonly node dist/auth/login.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.3",
    "google-auth-library": "^11.1.0",
    "googleapis": "^181.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
